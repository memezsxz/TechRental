@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}


<div class="forgot-confirm-container">
    <div class="forgot-confirm-card">
        <h2 class="forgot-confirm-title">Check your email 📬</h2>
        <p class="forgot-confirm-message">
            Please check your email to reset your password.
        </p>
    </div>
</div>
