@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}


<div class="login-container">
    <h2 class="login-title">Welcome back 👋</h2>

    <div class="login-card">
        <form id="account" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="login-form-group">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="login-form-group">
                <label asp-for="Input.Password" class="form-label"></label>
                <div class="position-relative">
                    <input asp-for="Input.Password" type="password" class="form-control pe-5" id="passwordInput" autocomplete="new-password" aria-required="true" />
                    <i class="bi bi-eye-slash position-absolute top-50 end-0 translate-middle-y me-3" id="toggleIcon" style="cursor: pointer;"></i>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="login-form-check">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe" class="form-check-label mb-0">
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <button id="login-submit" type="submit" class="btn login-btn w-100">Login</button>

            <div class="login-footer">
                @* <p><a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a></p> *@
                <p>Don’t have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a></p>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
