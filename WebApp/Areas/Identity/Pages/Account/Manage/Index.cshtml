@page
@model IndexModel
@{
    ViewData["Title"] = "Your Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="profile-page mt-n3">

    <partial name="_StatusMessage" for="StatusMessage" />

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-success mb-0">My Profile</h2>
        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-danger px-4 py-2 rounded-3">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </button>
        </form>
    </div>

    <!-- Profile Icon & Role -->
    <div class="text-center mb-4">
        <i class="bi bi-person-circle text-success" style="font-size: 5rem;"></i>
        <h5 class="mt-2 text-muted">@Model.Input.role</h5>
    </div>

    <!-- Profile Form -->
    <form id="profile-form" method="post" class="card shadow-sm border-0 rounded-4 p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Input.FirstName" class="form-label fw-semibold text-muted">First Name</label>
                <input asp-for="Input.FirstName" class="form-control rounded-3" />
                <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.LastName" class="form-label fw-semibold text-muted">Last Name</label>
                <input asp-for="Input.LastName" class="form-control rounded-3" />
                <span asp-validation-for="Input.LastName" class="text-danger small"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Username" class="form-label fw-semibold text-muted">Email</label>
                <input asp-for="Username" class="form-control rounded-3 bg-light" disabled />
            </div>
            <div class="col-md-6">
                <label asp-for="Input.PhoneNumber" class="form-label fw-semibold text-muted">Phone Number</label>
                <input asp-for="Input.PhoneNumber" class="form-control rounded-3" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex justify-content-center gap-3 mt-4">
            <button id="update-profile-button" type="submit" class="btn btn-success px-4 py-2">
                <i class="bi bi-check-circle me-1"></i> Save Changes
            </button>
            <a asp-page="./ChangePassword" class="btn btn-outline-success px-4 py-2">
                <i class="bi bi-shield-lock me-1"></i> Change Password
            </a>
        </div>
    </form>
    <!-- Logout Button (well-placed under profile form) -->

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
