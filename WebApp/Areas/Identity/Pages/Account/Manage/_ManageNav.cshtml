@using WebApp.Areas.Identity.Data
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<div class="manage-card card shadow-sm border-0 rounded-4 h-100">
    <div class="card-body">
        <h5 class="text-success fw-bold mb-3">Manage Account</h5>
        <ul class="nav flex-column gap-2">
            <li class="nav-item">
                <a class="manage-link btn w-100 text-start px-3 py-2 border @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
                    <i class="bi bi-person me-2"></i> Profile
                </a>
            </li>
            <li class="nav-item">
                <a class="manage-link btn w-100 text-start px-3 py-2 border @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email">
                    <i class="bi bi-envelope me-2"></i> Email
                </a>
            </li>
            <li class="nav-item">
                <a class="manage-link btn w-100 text-start px-3 py-2 border @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
                    <i class="bi bi-lock me-2"></i> Password
                </a>
            </li>
            @if (hasExternalLogins)
            {
                @* <li class="nav-item"> *@
                @*     <a class="manage-link btn w-100 text-start px-3 py-2 border @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins"> *@
                @*         <i class="bi bi-box-arrow-in-right me-2"></i> External Logins *@
                @*     </a> *@
                @* </li> *@
            }
            @* <li class="nav-item"> *@
            @*     <a class="manage-link btn w-100 text-start px-3 py-2 border @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" asp-page="./TwoFactorAuthentication"> *@
            @*         <i class="bi bi-shield-lock me-2"></i> Two-Factor Auth *@
            @*     </a> *@
            @* </li> *@
            <li class="nav-item">
                <a class="manage-link btn w-100 text-start px-3 py-2 border @ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData">
                    <i class="bi bi-person-vcard me-2"></i> Personal Data
                </a>
            </li>
        </ul>
    </div>
</div>
