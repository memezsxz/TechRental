@model Database.Core.Domain.RentalRequest

@{
    ViewData["Title"] = "Edit Rental Request";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-5 page-title">EDIT RENTAL REQUEST #@Model.Id</h2>

<!-- CUSTOMER INFO -->
<div class="container mb-5 pb-4 border-bottom">
    <h4 class="mb-4 text-success fw-semibold">Customer Info</h4>
    <div class="row mb-4">
        <div class="col-md-6">
            <label>First Name</label>
            <input class="form-control" value="@Model.Customer?.FirstName" readonly />
        </div>
        <div class="col-md-6">
            <label>Last Name</label>
            <input class="form-control" value="@Model.Customer?.LastName" readonly />
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <label>Phone Number</label>
            <input class="form-control" value="@Model.Customer?.PhoneNumber" readonly />
        </div>
        <div class="col-md-6">
            <label>Email</label>
            <input class="form-control" value="@Model.Customer?.Email" readonly />
        </div>
    </div>
</div>

<!-- EDITABLE REQUEST INFO -->
<div class="container mb-5">
    <h4 class="mb-4 text-success fw-semibold">Request Info</h4>

    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />

        <div class="form-group mb-4">
            <label>Equipment Title</label>
            <input class="form-control" value="@Model.Equipment?.Name" readonly />
            <input type="hidden" asp-for="EquipmentId" />
        </div>

        <div class="row mb-4">
            <!-- Start Date -->
            <div class="mb-3">
                <label asp-for="StartDate" class="form-label">Pick up Date</label>
                <input asp-for="StartDate" class="form-control" id="startDate" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <!-- Return Date -->
            <div class="mb-3">
                <label asp-for="ReturnDate" class="form-label">Return Date</label>
                <input asp-for="ReturnDate" class="form-control" id="returnDate" />
                <span asp-validation-for="ReturnDate" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <label asp-for="RentalPerDay">Total Cost (BD)</label>
                <input asp-for="RentalPerDay" id="RentalPerDay" class="form-control" />
                <span asp-validation-for="RentalPerDay" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="StatusId">Status</label>
                <select asp-for="StatusId" class="form-control" asp-items="ViewBag.StatusId"></select>
                <span asp-validation-for="StatusId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Notes">Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <input type="hidden" asp-for="CustomerId" />
        <input type="hidden" asp-for="CreatedAt" />
        <input type="hidden" asp-for="UpdatedAt" />

        <div class="d-flex justify-content-center gap-3 mt-5">
            <input type="submit" value="Save Changes" class="btn btn-success px-4" />
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <style>
        .flatpickr-day.reserved-day {
            background-color: #c8f7c5 !important;
            border-radius: 50%;
            color: #000 !important;
        }
    </style>

    <script>
        // Reserved dates passed from controller as a list of strings ["2025-05-10", ...]
        const reservedDates = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((List<string>)ViewBag.UnavailableDates));

        function isReservedDate(date) {
            const iso = date.toISOString().split('T')[0];
            return reservedDates.includes(iso);
        }

        // Flatpickr instance for Return Date
        const returnPicker = flatpickr("#returnDate", {
            dateFormat: "Y-m-d",
            minDate: "today",
            defaultDate: "@Model.ReturnDate.ToString("yyyy-MM-dd")",
            disable: reservedDates,
            onDayCreate: function (dObj, dStr, fp, dayElem) {
                const date = dayElem.dateObj;
                if (isReservedDate(date)) {
                    dayElem.classList.add("reserved-day");
                }
            }
        });

        // Flatpickr instance for Start Date
        const startPicker = flatpickr("#startDate", {
            dateFormat: "Y-m-d",
            minDate: "today",
            defaultDate: "@Model.StartDate.ToString("yyyy-MM-dd")",
            disable: reservedDates,
            onChange: function (selectedDates, dateStr) {
                if (dateStr) {
                    const startDate = new Date(dateStr);
                    let maxDate = null;

                    for (let i = 1; i < 30; i++) {
                        const checkDate = new Date(startDate);
                        checkDate.setDate(startDate.getDate() + i);
                        const iso = checkDate.toISOString().split('T')[0];
                        if (reservedDates.includes(iso)) {
                            maxDate = new Date(checkDate);
                            maxDate.setDate(maxDate.getDate() - 1);
                            break;
                        }
                    }

                    returnPicker.set('minDate', dateStr);
                    returnPicker.set('maxDate', maxDate);
                }
            },
            onDayCreate: function (dObj, dStr, fp, dayElem) {
                const date = dayElem.dateObj;
                if (isReservedDate(date)) {
                    dayElem.classList.add("reserved-day");
                }
            }
        });

        // Auto-calculate rental price and duration
        function calculateDaysAndTotal() {
            const start = new Date(document.getElementById('startDate').value);
            const end = new Date(document.getElementById('returnDate').value);
            const perDay = parseFloat('@Model.RentalPerDay');

            if (!isNaN(start.getTime()) && !isNaN(end.getTime()) && end >= start) {
                const days = Math.ceil((end - start) / (1000 * 60 * 60 * 24)) + 1;
                const total = perDay * days;
                document.getElementById('RentalPerDay').value = total.toFixed(2);
            } else {
                document.getElementById('RentalPerDay').value = "0.00";
            }
        }

        // Trigger calculation on load and on change
        document.addEventListener('DOMContentLoaded', calculateDaysAndTotal);
        document.getElementById('startDate').addEventListener('change', calculateDaysAndTotal);
        document.getElementById('returnDate').addEventListener('change', calculateDaysAndTotal);
    </script>
}
