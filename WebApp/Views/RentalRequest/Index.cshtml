@model IEnumerable<Database.Core.Domain.RentalRequest>
    @* ------------------------------------------------------------------------------
    View: Index.cshtml (RentalRequest)
    Purpose:
        Displays a paginated list of all rental requests.
        Supports filtering by request status, searching by equipment/email/ID,
        sorting by date, and role-based logic (e.g., customer cannot see User ID).
        Customers only see their own requests.
        Admins and Managers can see all requests and full metadata.
    Features:
        - Status dropdown filter
        - Keyword search
        - Sorting (Newest/Oldest)
        - Pagination with bootstrap styles
        - Highlighted table rows on hover
        - Tooltips and row click-to-view
        - Conditional display of user email based on role
   ------------------------------------------------------------------------------ *@

@{
    var isCustomer = User.IsInRole("Customer");
    var userEmail = isCustomer ? User.Identity?.Name : null;
    ViewData["Title"] = "Rental Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var statusOptions = ViewBag.StatusOptions as List<string> ?? new List<string>();
    var currentStatus = ViewBag.StatusFilter as string;
    var currentSearch = ViewBag.Search as string;
    var currentSort = ViewBag.SortBy as string;
}

<div class="container mt-5">
    <h2 class="text-center mb-5 page-title">RENTAL REQUESTS</h2>

    <!-- FILTER / SEARCH / SORT FORM -->
    <form method="get" class="container d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3" style="max-width: 1100px;">
        <!-- Status filter dropdown -->
        <div style="flex: 1; min-width: 200px;">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                @foreach (var status in statusOptions)
                {
                    var selected = currentStatus == status ? "selected" : "";
                    @:<option value="@status" @selected>@status</option>
                }
            </select>
        </div>

        <!-- Search by equipment, email, or ID -->
        <div style="flex: 2; min-width: 300px;">
            <input type="text" name="search" class="form-control"
                   placeholder="Search by Equipment, Email, or ID"
                   value="@currentSearch" />
        </div>

        <!-- Sort dropdown -->
        <div style="flex: 1; min-width: 180px;">
            <select name="sortBy" class="form-select">
                @{
                    var selectedSort = currentSort == "date_desc" ? "selected" : "";
                    @:<option value="date_desc" @selectedSort>Newest First</option>

                    selectedSort = currentSort == "date_asc" ? "selected" : "";
                    @:<option value="date_asc" @selectedSort>Oldest First</option>
                }
            </select>
        </div>

        <!-- Submit button -->
        <div>
            <button type="submit" class="btn btn-success px-4">Search</button>
        </div>
    </form>

    <!-- RESULTS TABLE -->
    <table class="table text-center align-middle">
        <thead>
            <tr>
                <th>Request ID</th>
                @if (!isCustomer)
                {
                    <th>User ID</th>
                }
                <th>Equipment Title</th>
                <th>Status</th>
                <th>Pick up Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="clickable-row"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    title="Click to view details"
                    data-href="@Url.Action("Details", "RentalRequest", new { id = item.Id })"
                    style="cursor: pointer;">
                    <td>@item.Id</td>
                    @if (!isCustomer)
                    {
                        <td>@item.Customer?.Id</td>
                    }
                    <td>@item.Equipment?.Name</td>
                    <td>
                        @{
                            var status = item.Status?.StatusName?.ToLower();
                            var badgeClass = status switch
                            {
                                "approved" => "success",
                                "pending" => "warning",
                                "rejected" => "danger",
                                "cancelled" => "dark",
                                _ => "secondary"
                            };
                        }
                        <span class="badge bg-@badgeClass text-uppercase">
                            @item.Status?.StatusName
                        </span>
                    </td>
                    <td>@item.StartDate.ToString("d/M/yyyy h:mmtt")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- PAGINATION -->
<nav aria-label="Rental pagination" class="mt-4">
    <ul class="pagination justify-content-center">
        @if (ViewBag.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link text-success"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-search="@currentSearch"
                   asp-route-statusFilter="@currentStatus"
                   asp-route-sortBy="@currentSort"
                   asp-route-userEmail="@userEmail">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>
        }

        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            var isActive = (int)ViewBag.CurrentPage == i ? "active" : "";
            var linkClass = (int)ViewBag.CurrentPage == i ? "bg-success text-white border-success" : "text-success";

            <li class="page-item @isActive">
                <a class="page-link @linkClass"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-search="@currentSearch"
                   asp-route-statusFilter="@currentStatus"
                   asp-route-sortBy="@currentSort"
                   asp-route-userEmail="@userEmail"
                   style="border-radius: 8px; margin: 0 4px;">
                    @i
                </a>
            </li>
        }

        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <li class="page-item">
                <a class="page-link text-success"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-search="@currentSearch"
                   asp-route-statusFilter="@currentStatus"
                   asp-route-sortBy="@currentSort"
                   asp-route-userEmail="@userEmail">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        }
    </ul>
</nav>
