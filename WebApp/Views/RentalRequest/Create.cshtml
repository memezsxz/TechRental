@model Database.Core.Domain.RentalRequest

@* -------------------------------------------------------------------------------------
    Page: Create.cshtml
    Purpose:
        This page allows a customer to create a new rental request for a specific equipment item.
        It shows equipment details on the left, and a form to input rental dates and notes on the right.
        Flatpickr is used for date selection, ensuring users cannot select unavailable dates.
        The total cost is calculated dynamically based on rental duration and daily rate.

    Features:
        - Displays equipment name, condition, rating, and price
        - Accepts a start and return date using Flatpickr calendar
        - Prevents selection of reserved dates (provided via ViewBag)
        - Calculates and displays the total price and number of days
        - Accepts customer notes
        - Hidden fields pass equipment ID, rental rate, customer ID, and status
        - Submits to POST /RentalRequest/Create

    JS Integration:
        - JS uses data from a hidden JSON script tag (reservedDatesData)
        - Automatically sets the first available date for rental
        - Shows real-time price summary based on selected dates
        - Shared logic handled by rental-request.js
   -------------------------------------------------------------------------------------- *@

@{
    ViewData["Title"] = "Create Rental Request";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var equipment = ViewBag.Equipment as Database.Core.Domain.Equipment;
}

<div class="container my-5">
    <h2 class="text-center mb-5 page-title">Create Rental Request</h2>

    <div class="row justify-content-center">
        <div class="col-md-10 d-flex flex-wrap justify-content-between gap-5">

            <!-- Left Column: Equipment Details -->
            <div class="flex-fill" style="min-width: 300px;">
                <h4>Equipment Details</h4>

                <p><strong>Equipment title:</strong> @equipment?.Name</p>
                <p><strong>Condition:</strong> @equipment?.ConditionStatus?.ConditionName</p>

                @{
                    // Average customer rating (default to 0 if no feedbacks)
                    var averageRating = equipment?.Feedbacks?.Any() == true
                    ? equipment.Feedbacks.Average(f => f.Rate)
                    : 0;
                }
                <p><strong>Rating:</strong> @Math.Round(averageRating, 1) ⭐</p>
                <p><strong>Price:</strong> @equipment?.RentalPricePerDay BHD / Day</p>

                <!-- Submit Button -->
                <button type="submit" form="rentalForm" class="btn btn-success mt-4 w-100">
                    Send Request
                </button>

                <!-- Cancel Button -->
                <a href="@Url.Action("Details", "Equipment", new { id = equipment?.Id })"
                   class="btn btn-outline-success mt-2 w-100">
                    Cancel
                </a>
            </div>

            <!-- Right Column: Rental Request Form -->
            <div class="flex-fill" style="min-width: 300px;">
                <h4>Request Details</h4>
                <form asp-action="Create" id="rentalForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Equipment ID (Hidden) -->
                    <input type="hidden" asp-for="EquipmentId" value="@equipment?.Id" />

                    <!-- Rental Start Date -->
                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label">From</label>
                        <input asp-for="StartDate" class="form-control" id="startDate" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <!-- Rental Return Date -->
                    <div class="mb-3">
                        <label asp-for="ReturnDate" class="form-label">To</label>
                        <input asp-for="ReturnDate" class="form-control" id="returnDate" />
                        <span asp-validation-for="ReturnDate" class="text-danger"></span>
                    </div>

                    <!-- Price Calculation Display -->
                    <div class="mb-3">
                        <span id="priceDetails">@equipment?.RentalPricePerDay BD/Day → 0 BD/0 Days</span>
                    </div>

                    <!-- Optional Notes -->
                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" placeholder="e.g. I will pick it up at 5pm."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <!-- Hidden Meta Fields -->
                    <input type="hidden" asp-for="RentalPerDay" value="@equipment?.RentalPricePerDay" />
                    <input type="hidden" asp-for="StatusId" value="1" />
                </form>

                <!-- Calendar Legend -->
                <div class="mt-4">
                    <h5>Legend</h5>
                    <ul class="list-unstyled d-flex gap-4">
                        <li>
                            <span style="display: inline-block; width: 20px; height: 20px; background-color: #c8f7c5; border-radius: 50%; border: 1px solid #ccc; vertical-align: middle;"></span>
                            <span class="ms-2">Reserved Date</span>
                        </li>
                        <li>
                            <span style="display: inline-block; width: 20px; height: 20px; background-color: #ffffff; border-radius: 50%; border: 1px solid #ccc; vertical-align: middle;"></span>
                            <span class="ms-2">Available Date</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pass reserved (unavailable) dates from server to JS -->
<script id="reservedDatesData" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize((List<string>)ViewBag.UnavailableDates))
</script>

<!-- Pass daily rental rate to JS -->
<input type="hidden" id="rentalPerDay" value="@equipment?.RentalPricePerDay" />

@section Scripts {
    <!-- Shared JS logic for flatpickr, validations, and cost calculation -->
    <script src="~/js/rental-request.js"></script>
}
