@model IEnumerable<Database.Core.Domain.AuditLog>

@{
    ViewData["Title"] = "Audit Trails";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4">

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold text-success">Audit Trails</h2>
    <div class="btn-group">
        <a class="btn btn-success active">Audit Trails</a>
        <a class="btn btn-outline-success" href="/ErrorLogs">Error Logs</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-bordered align-middle">
        <thead class="table-light text-success">
            <tr>
                <th>Timestamp</th>
                <th>User ID</th>
                <th>Source</th>
                <th>Action</th>
                <th>Old Value</th>
                <th>New Value</th>
                <th>Source Entity</th>
                <th>Effected Key</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Timestamp</td>
                    <td>@item.User?.Id</td>
                    <td>@item.Source</td>
                    <td>@item.ActionType</td>
                    <td>@item.DataBeforeAction</td>
                    <td>@item.DataAfterAction</td>
                    <td>@item.SourceEntity</td>
                    <td>@item.AffectedRecordKey</td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>
