@model IEnumerable<Database.Core.Domain.Equipment>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="container my-4">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <!-- Make the card clickable by wrapping it with a link -->
                <a href="@Url.Action("Details", "Equipment", new { id = item.Id })" class="text-decoration-none">
                    <div class="card-flip">
                        <!-- Card Front -->
                        <div class="card-front">
                            <div class="card-body">
                                <!-- Equipment Name -->
                                <h3 class="card-title equipment-name">@item.Name</h3>

                                <!-- Rental Price (smaller font) -->
                                <p class="card-text rental-price"><strong>Rental Price per Day:</strong> @item.RentalPricePerDay</p>

                                <!-- Condition Status (styled differently) -->
                                <p class="card-text condition-status">@item.ConditionStatus.ConditionName</p>

                            </div>
                        </div>

                        <!-- Card Back -->
                        <div class="card-back">
                            <div class="card-body">
                                <h5 class="card-title">Rent Now</h5>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .card-flip {
        position: relative;
        width: 100%;
        height: 350px; /* Fixed height for all cards */
        transform-style: preserve-3d;
        transition: transform 0.6s;
        cursor: pointer;
    }

        /* Flip the card when hovering */
        .card-flip:hover {
            transform: rotateY(180deg);
        }

    .card-front,
    .card-back {
        backface-visibility: hidden;
        position: absolute;
        width: 100%;
        height: 100%;
        padding: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        overflow: hidden;
    }

    .card-front {
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 0.375rem;
    }

    .card-back {
        background-color: #3CAD68; /* Set the background to green */
        color: white; /* Set text color to white */
        border: 1px solid #ddd;
        border-radius: 0.375rem;
        transform: rotateY(180deg); /* Make the back face initially hidden */
    }

    .card-body {
        padding: 1rem;
    }

    /* Equipment Name: Large and Bold */
    .equipment-name {
        font-size: 1.5rem; /* Larger size for the name */
        font-weight: bold;
        margin-bottom: 10px;
    }

    /* Rental Price: Smaller and lighter */
    .rental-price {
        font-size: 0.875rem; /* Smaller font size */
        color: #6c757d; /* Lighter text color */
        margin-bottom: 10px;
    }

    /* Condition Status: Make it stand out */
    .condition-status {
        font-size: 1rem;
        font-weight: bold;
        color: #28a745; /* Green color for condition status */
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 1rem;
        margin-bottom: 10px;
    }

    .btn {
        font-size: 1rem;
        padding: 10px 20px;
    }
</style>

