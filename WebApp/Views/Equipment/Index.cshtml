@model IEnumerable<Database.Core.Domain.Equipment>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-end my-3">
    <a asp-action="Create" class="btn create-button">Add New Equipment</a>
</div>


<div class="container my-4">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <!-- Make the card clickable by wrapping it with a link -->
                <a href="@Url.Action("Details", "Equipment", new { id = item.Id })" class="text-decoration-none">
                    <div class="card-flip">
                        <!-- Card Front -->
                        <div class="card-front">

                            @* <img src="@Url.Action("GetImage", "Image", new { id = user.ImageId })" alt="User Image" /> *@
                            <div class="card-body p-0 position-relative">
                                @if (item.Image != null)
                                {
                                    <div class="image-wrapper">
                                        <img src="@Url.Action("GetImage", "Image", new { id = item.ImageId })" 
                                            alt="Equipment Image"
                                             class="equipment-image"
                                             loading="lazy" />
                                        <div class="image-title-overlay-bottom">
                                            @item.Name
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p>No Image Available</p>
                                }
                            </div>

                        </div>

                        <!-- Card Back -->
                        <div class="card-back">
                            <div class="card-body">
                                <h5 class="card-title">Rent Now</h5>
                                <br />
                                <p class="card-text rental-price">@item.RentalPricePerDay BD/Day Only</p>

                                <br />
                                <br />
                                <br />

                                <!-- Condition Status (styled differently) -->
                                <p class="card-text condition-status">@item.ConditionStatus.ConditionName</p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>

    .image-wrapper {
        position: relative;
        width: 100%;
        height: 250px; /* Fixed height for the image area */
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8f9fa; /* Light background if image is small */
        border-top-left-radius: 0.375rem;
        border-top-right-radius: 0.375rem;
    }

    .equipment-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    /* Zoom effect on hover */
    .card-flip:hover .equipment-image {
        transform: scale(1.05);
    }

    /* Title overlay at bottom */
    .image-title-overlay-bottom {
        position: absolute;
        bottom: 0;
        width: 100%;
        padding: 4px 12px;
        background: rgba(255, 255, 255, 0.85); /* Semi-transparent white */
        font-size: 1.1rem; /* Same font size for all */
        font-weight: bold;
        color: #333;
        text-align: center;
        border-bottom-left-radius: 0.375rem;
        border-bottom-right-radius: 0.375rem;
    }

    .card-flip {
        position: relative;
        width: 100%;
        height: 350px; /* Fixed height for all cards */
        transform-style: preserve-3d;
        transition: transform 0.6s;
        cursor: pointer;
    }

        /* Flip the card when hovering */
        .card-flip:hover {
            transform: rotateY(180deg);
        }

    .card-front,
    .card-back {
        backface-visibility: hidden;
        position: absolute;
        width: 100%;
        height: 100%;
        padding: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        overflow: hidden;
    }

    .card-front {
        background-color: #fff;
        border: 1px solid #ddd;
        border-radius: 0.375rem;
    }

    .card-back {
        background-color: #3CAD68; /* Set the background to green */
        color: white; /* Set text color to white */
        border: 1px solid #ddd;
        border-radius: 0.375rem;
        transform: rotateY(180deg); /* Make the back face initially hidden */
    }

    .card-body {
        padding: 1rem;
    }

    /* Equipment Name: Large and Bold */
    .equipment-name {
        font-size: 1.5rem; /* Larger size for the name */
        font-weight: bold;
        margin-bottom: 20px;
    }

    /* Rental Price: Smaller and lighter */
    .rental-price {
        font-size: 0.875rem; /* Smaller font size */
        color: #ddd; /* Lighter text color */
        margin-bottom: 10px;
    }

    /* Condition Status: Make it stand out */
    .condition-status {
        font-size: 1rem;
        font-weight: bold;
        color: #ddd; /* Green color for condition status */
        margin-bottom: 12px;
    }

    .card-text {
        font-size: 1rem;
        margin-bottom: 10px;
    }

    .create-button {
        background-color: #3CAD68; /* Match card back green */
        color: white; /* Text color */
        margin-top: 10px;
        margin-left: 20px;
        font-size: 1rem;
        padding: 10px 20px;
        border: none;
        border-radius: 0.375rem;
        transition: background-color 0.3s ease;
        text-decoration: none;
    }

        /* Hover effect */
        .create-button:hover {
            background-color: #349e5a; /* Slightly darker green on hover */
            color: white;
            text-decoration: none;
        }



    .card-title {
        font-weight: bold;
        font-size: 24px;

    }
</style>

