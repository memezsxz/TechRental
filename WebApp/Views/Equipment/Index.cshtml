@using Identity
@model IEnumerable<Database.Core.Domain.Equipment>

@* -------------------------------------------------------------------------------------
    Page: Index.cshtml
    Purpose:
        This page displays a paginated, searchable, and filterable grid of all equipment 
        available in the system. It supports dynamic filtering by category, searching by name, 
        and sorting by name or price. Each equipment item is shown in a clickable flip card
        with image, name, rental price, and condition.

    Features:
        - Admins and Managers can see "Add New Equipment" button
        - Filtering by category (from ViewBag.Categories)
        - Searching by equipment name
        - Sorting by name A–Z / Z–A and price low–high / high–low
        - Responsive card grid layout with image flip animations
        - Clickable cards link to the Equipment Details page
        - Card back shows action button (Manage or Rent Now) based on user role
        - Pagination with route state persistence for filter, search, sort, and current page

    JS Integration:
        - Shared card-flip animation (handled via CSS or JS)
        - Pagination handled via server-side logic (controller + ViewBag)
---------------------------------------------------------------------------------------- *@

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Add button visible only for Admins or Managers
    if (User.IsInRole(RoleConstants.Admin) || User.IsInRole(RoleConstants.Manager))
    {
        <div class="d-flex justify-content-end my-3">
            <a asp-action="Create" class="btn create-button">Add New Equipment</a>
        </div>
    }
}

<div class="container my-4">
    <!-- Filter/Search/Sort Form -->
    <form method="get"
          id="filterForm"
          class="container d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3"
          style="max-width: 1100px;">

        <!-- Category Dropdown -->
        <div style="flex: 1; min-width: 200px;">
            <select name="category" class="form-select" style="min-width: 200px;">
                <option value="">All Categories</option>
                @foreach (var category in ViewBag.Categories as List<string>)
                {
                    var selected = ViewBag.Category == category ? "selected" : "";
                    @:<option value="@category" @selected>@category</option>
                }
            </select>
        </div>

        <!-- Search Box -->
        <div style="flex: 2; min-width: 300px;">
            <input type="text" name="search" class="form-control"
                   placeholder="Search by equipment name"
                   style="min-width: 240px;" value="@ViewBag.Search" />
        </div>

        <!-- Sort Options -->
        <div style="flex: 1; min-width: 180px;">
            @{
                var sortBy = ViewBag.SortBy as string ?? "";
            }
            <select name="sortBy" class="form-select" style="min-width: 180px;">
                <option value="">Sort By</option>
                <option value="name_asc" selected="@(sortBy == "name_asc")">Name A–Z</option>
                <option value="name_desc" selected="@(sortBy == "name_desc")">Name Z–A</option>
                <option value="price_asc" selected="@(sortBy == "price_asc")">Price Low–High</option>
                <option value="price_desc" selected="@(sortBy == "price_desc")">Price High–Low</option>
            </select>
        </div>

        <!-- Submit Button -->
        <div>
            <button type="submit" class="btn btn-success px-4">SEARCH</button>
        </div>
    </form>

    <!-- Equipment Cards Grid -->
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <!-- Entire card is a clickable link to Details page -->
                <a href="@Url.Action("Details", "Equipment", new { id = item.Id })"
                   class="text-decoration-none">

                    <!-- Flip Card -->
                    <div class="card-flip">
                        <!-- Card Front (Image) -->
                        <div class="card-front">
                            <div class="card-body p-0 position-relative">
                                @if (item.Image != null)
                                {
                                    <div class="image-wrapper">
                                        <img src="@Url.Action("GetImage", "Image", new { id = item.ImageId })"
                                             alt="Equipment Image"
                                             class="equipment-image"
                                             loading="lazy" />
                                        <!-- Name Overlay -->
                                        <div class="image-title-overlay-bottom">
                                            @item.Name
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <p>No Image Available</p>
                                }
                            </div>
                        </div>

                        <!-- Card Back (Action Info) -->
                        <div class="card-back">
                            <div class="card-body">
                                @if (User.IsInRole(RoleConstants.Manager) || User.IsInRole(RoleConstants.Admin))
                                {
                                    <h5 class="card-title">Manage Item</h5>
                                }
                                else
                                {
                                    <h5 class="card-title">Rent Now</h5>
                                }

                                <br />
                                <p class="card-text rental-price">@item.RentalPricePerDay BD/Day Only</p>
                                <br /><br /><br />

                                <!-- Condition Info -->
                                <p class="card-text condition-status">@item.ConditionStatus.ConditionName</p>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<!-- PAGINATION CONTROLS -->
<nav class="mt-4" aria-label="Equipment pagination">
    <ul class="pagination justify-content-center">

        <!-- Previous Page -->
        @if (ViewBag.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link text-success"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-category="@ViewBag.Category"
                   asp-route-sortBy="@ViewBag.SortBy">
                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>
        }

        <!-- Numbered Pages -->
        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            var isActive = i == ViewBag.CurrentPage ? "active" : "";
            var linkClass = i == ViewBag.CurrentPage ? "bg-success text-white border-success" : "text-success";

            <li class="page-item @isActive">
                <a class="page-link @linkClass"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-search="@ViewBag.Search"
                   asp-route-category="@ViewBag.Category"
                   asp-route-sortBy="@ViewBag.SortBy"
                   style="border-radius: 8px; margin: 0 4px;">
                    @i
                </a>
            </li>
        }

        <!-- Next Page -->
        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
        {
            <li class="page-item">
                <a class="page-link text-success"
                   asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-category="@ViewBag.Category"
                   asp-route-sortBy="@ViewBag.SortBy">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        }
    </ul>
</nav>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("filterForm");

        // Auto-submit when sort or category changes
        form.querySelector("select[name='sortBy']").addEventListener("change", () => form.submit());
        form.querySelector("select[name='category']").addEventListener("change", () => form.submit());

        // Optional: auto-submit when pressing Enter in search
        form.querySelector("input[name='search']").addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
                form.submit();
            }
        });
    });
</script>
