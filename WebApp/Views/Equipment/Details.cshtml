@model Database.Core.Domain.Equipment

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container my-5">

    <!-- Back to List Button -->
    <div class="mb-4 text-start">
        <a asp-action="Index" class="back-link">&lt; Back to List</a>
    </div>

    <div class="row">
        <!-- Left Column: Image -->
        <div class="col-md-6 d-flex justify-content-center align-items-center">
            @if (Model.Image != null)
            {
                <img src="@Url.Action("GetImage", "Image", new { id = Model.Image.ImageId })" alt="Equipment Image" class="img-fluid rounded" style="max-height: 350px;" />
            }
            else
            {
                <div class="border p-5 text-muted text-center" style="width:100%; height:300px;">No Image Available</div>
            }
        </div>

        <!-- Right Column: Details -->
        <div class="col-md-6">
            <h2 class="equipment-title">@Model.Name</h2>

            <div class="equipment-section">
                <h5 class="section-header">Description</h5>
                <ul class="description-list">
                    @foreach (var line in (Model.Description ?? "").Split('\n'))
                    {
                        if (!string.IsNullOrWhiteSpace(line))
                        {
                            <li>@line</li>
                        }
                    }
                </ul>
            </div>

            <div class="equipment-section">
                <h5 class="section-header">Condition</h5>
                <p class="condition-text">@Model.ConditionStatus?.ConditionName</p>
            </div>

            <div class="rental-price mt-4">
                <h3 class="price-text">
                    @Model.RentalPricePerDay <span class="currency">BHD</span> <span class="per-day">/ Day</span>
                </h3>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("Rent", "Equipment", new { id = Model.Id })" class="btn btn-success custom-action-btn w-100 mb-3">Rent Now</a>

                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-success custom-action-btn w-100 mb-3">Edit</a>

                <button type="button" class="btn btn-danger custom-action-btn w-100" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    Delete
                </button>
            </div>

        </div>

    </div>

    <!-- Ratings and Comments Section -->
    <div class="row mt-5">
        <div class="col-md-12">
            @{
                var averageRating = Model.Feedbacks.Any() ? Model.Feedbacks.Average(f => f.Rate) : 0;
            }
            <h5 class="mb-3">Overall Rating: <strong>@Math.Round(averageRating, 1)</strong></h5>

            <h5 class="mb-3">Comments</h5>
            <div class="list-group">
                @foreach (var comment in Model.Feedbacks)
                {
                    <div class="list-group-item mb-2 rounded border">
                        <div class="d-flex align-items-center mb-2">
                            <div class="rounded-circle bg-light d-flex justify-content-center align-items-center" style="width:40px; height:40px;">
                                <i class="fas fa-user"></i>
                            </div>
                            <strong class="ms-3">@comment.User.FirstName @comment.User.LastName</strong>
                        </div>
                        <p class="text-muted mb-1">@comment.Note</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4">
            <!-- Notice: rounded-4 for softer corners -->

            <div class="modal-body text-center">
                <i class="fas fa-exclamation-triangle text-danger mb-3" style="font-size: 2rem;"></i>
                <p class="mb-0">Are you sure you want to delete this equipment? <br /> This action cannot be undone.</p>
            </div>

            <div class="modal-footer border-0 d-flex justify-content-center gap-3">
                <button type="button" class="btn modal-cancel-btn" data-bs-dismiss="modal">Cancel</button>

                <form asp-action="Delete" asp-route-id="@Model?.Id" method="post" style="display:inline;">
                    <button type="submit" class="btn modal-delete-btn">Yes, Delete</button>
                </form>
            </div>

        </div>
    </div>
</div>


<style>
    .btn-success {
        background-color: #3CAD68;
        border-color: #3CAD68;
        font-size: 1.2rem;
        padding: 12px 20px;
        font-weight: bold;
    }

    .btn-outline-success {
        color: #3CAD68;
        border: 2px solid #3CAD68;
        background-color: white;
        font-size: 1.2rem;
        padding: 10px 0;
        font-weight: bold;
        transition: background-color 0.3s, color 0.3s;
    }

        .btn-outline-success:hover {
            background-color: #3CAD68;
            color: white;
            border-color: #3CAD68;
        }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        font-size: 1.2rem;
        padding: 12px 20px;
        font-weight: bold;
    }

        .btn-danger:hover {
            background-color: #c82333;
            border-color: #bd2130;
        }

    /* Modal Buttons */
    .modal-cancel-btn {
        width: 150px;
        background-color: transparent;
        color: #6c757d;
        font-weight: bold;
        border: none;
        padding: 10px 0;
        border-radius: 8px;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .modal-cancel-btn:hover {
            background-color: #6c757d;
            color: white;
        }

    .modal-delete-btn {
        width: 150px;
        background-color: #dc3545;
        border: none;
        color: white;
        font-weight: bold;
        padding: 10px 0;
        border-radius: 8px;
        transition: background-color 0.3s ease;
    }

        .modal-delete-btn:hover {
            background-color: #c82333;
        }

    /* Optional: Center Modal Text */
    .modal-body p {
        font-size: 1rem;
        color: #555;
    }

    /* General Action Buttons (Rent / Edit / Delete) */
    .custom-action-btn {
        font-size: 1.2rem;
        font-weight: bold;
        padding: 12px 0;
        border-radius: 8px; /* Rounded corners for all buttons */
        transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    }
</style>
