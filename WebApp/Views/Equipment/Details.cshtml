@model Database.Core.Domain.Equipment

@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <div class="row">
        <!-- Left Column: Equipment Image and Details -->
        <div class="col-md-6">
            <!-- Equipment Image (Default image if null) -->
            <img src="@Url.Content(string.IsNullOrEmpty(Model.Image?.ImageName) ? "/images/no-image-available.png" : Model.Image.ImageName)"
                 alt="@Model.Name"
                 class="img-fluid rounded mb-4" />
        </div>

        <div class="col-md-6">
            <!-- Equipment Name -->
            <h1 class="display-4 font-weight-bold">@Model.Name</h1>

            <!-- Rental Price per Day -->
            <p class="lead text-muted">Price: <strong>@Model.RentalPricePerDay</strong> / Day</p>

            <!-- Condition Status -->
            <p class="text-muted">Condition: <span class="badge badge-pill badge-info">@Model.ConditionStatus.ConditionName</span></p>

            <!-- Availability -->
            <p><strong>Availability:</strong> @Model.AvailabilityStatus.StatusName</p>

            <!-- Description -->
            <p><strong>Description:</strong></p>
            <p>@Model.Description</p> <!-- Added description -->
            <!-- Rent Now Button -->
            <a href="@Url.Action("Rent", "Equipment", new { id = Model.Id })" class="btn btn-success btn-lg btn-block">Rent Now</a>
        </div>
    </div>

    <!-- Overall Rating Section -->
    <div class="row mt-5">
        <div class="col-md-12">
            <!-- Calculate Overall Rating -->
            @{
                var averageRating = Model.Feedbacks.Any() ? Model.Feedbacks.Average(c => c.Rate) : 0;
            }

            <!-- Display Average Rating -->
            <h4>Overall Rating: <span class="text-warning">@Math.Round(averageRating, 1)</span> <i class="fas fa-star"></i></h4>
            <hr />

            <!-- Customer Comments Section -->
            <h5>Customer Comments:</h5>
            <div class="list-group">
                @foreach (var comment in Model.Feedbacks)
                {
                    <div class="list-group-item">
                        <strong>@comment.User.FirstName @comment.User.LastName</strong>
                        <p>@comment.Note</p>
                        <div class="rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="fa fa-star @((i <= comment.Rate) ? "checked" : "")"></span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Action Links -->
    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>

<!-- Add custom CSS for styling -->
<style>
    /* Overall Rating */
    .rating {
        font-size: 1.2rem;
        color: #f39c12;
    }

        .rating .fa-star.checked {
            color: #f1c40f;
        }

    /* Equipment Name */
    .display-4 {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 10px;
    }

    /* Description Section */
    p {
        font-size: 1rem;
        margin-bottom: 15px;
    }

    .lead {
        font-size: 1.25rem;
        margin-bottom: 20px;
    }

    /* Rent Now Button */
    .btn-block {
        width: 100%;
    }

    .btn-success {
        background-color: #28a745;
        border-color: #28a745;
        font-size: 1.2rem;
        padding: 12px 20px;
    }

    /* Comments Section */
    .list-group-item {
        padding: 10px;
    }

        .list-group-item strong {
            font-weight: bold;
        }

        .list-group-item p {
            margin-top: 5px;
        }

    /* Placeholder image styles */
    .img-fluid {
        width: 100%;
        height: auto;
        object-fit: cover;
    }
</style>
