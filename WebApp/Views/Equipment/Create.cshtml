@model Database.Core.Domain.Equipment

@{
    ViewData["Title"] = "Add Equipment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* <a asp-action="Index" class="back-link">&lt; Back</a> *@

<div class="text-center my-4">
    <h1 class="page-title">Add Equipment</h1>
</div>

<div class="container my-4">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div class="row">
            <!-- Left Side: Form -->
            <div class="col-md-8">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="RentalPricePerDay" class="form-label">Rental Price (BHD / Day)</label>
                    <input asp-for="RentalPricePerDay" class="form-control" />
                    <span asp-validation-for="RentalPricePerDay" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConditionStatusId" class="form-label">Equipment Condition</label>
                        <select asp-for="ConditionStatusId" class="form-select" asp-items="ViewBag.ConditionStatusId"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="AvailabilityStatusId" class="form-label">Equipment Availability</label>
                        <select asp-for="AvailabilityStatusId" class="form-select" asp-items="ViewBag.AvailabilityStatusId"></select>
                    </div>
                </div>
            </div>

            <!-- Right Side: Image Upload Box -->
            <div class="col-md-4 d-flex align-items-start justify-content-center">
                <div class="upload-box" onclick="document.getElementById('fileInput').click();">
                    <span id="upload-text">Add</span>
                    <input type="file" id="fileInput" name="ImageFile" style="display: none;" accept="image/*" onchange="previewImage(event)" />
                </div>
            </div>
        </div>

        <!-- Centered Buttons Below -->
        <div class="d-flex justify-content-center gap-3 mt-4">
            <input type="submit" value="Add" class="btn custom-btn" />
            <a asp-action="Index" class="btn custom-btn-outline">Cancel</a>
        </div>
    </form>
</div>


<style>
    .page-title {
        color: #3CAD68;
        font-weight: bold;
        font-size: 2rem;
        padding-top: 20px; /* Top padding for the title */
    }

    .back-link {
        color: #3CAD68;
        text-decoration: none;
        font-size: 1rem;
        margin-bottom: 20px;
        display: inline-block;
    }

    .upload-box {
        width: 100%;
        height: 250px;
        background-color: #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 1.2rem;
        border: 2px dashed #ccc;
        border-radius: 8px;
        cursor: pointer;
        background-size: cover;
        background-position: center;
    }


    .form-control, .form-select {
        border-radius: 0.375rem;
    }

    .btn-success {
        background-color: #3CAD68;
        border-color: #3CAD68;
        font-weight: bold;
    }

        .btn-success:hover {
            background-color: #349e5a;
            border-color: #349e5a;
        }

    .btn-outline-success {
        color: #3CAD68;
        border-color: #3CAD68;
        font-weight: bold;
    }

        .btn-outline-success:hover {
            background-color: #3CAD68;
            color: white;
        }

    .custom-btn {
        width: 150px; /* Same width for both buttons */
        background-color: #3CAD68;
        color: white;
        font-weight: bold;
        border: none;
        padding: 10px 0;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

        .custom-btn:hover {
            background-color: #349e5a;
            color: white;
        }

    .custom-btn-outline {
        width: 150px; /* Same width */
        background-color: transparent;
        color: #3CAD68;
        font-weight: bold;
        border: 2px solid #3CAD68;
        padding: 10px 0;
        border-radius: 5px;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .custom-btn-outline:hover {
            background-color: #3CAD68;
            color: white;
        }

    .upload-box {
        width: 100%;
        height: 250px;
        background-color: #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 1.2rem;
        border: 2px dashed #ccc;
        border-radius: 8px;
        cursor: pointer;
        background-size: cover;
        background-position: center;
    }

</style>

<script>
    function previewImage(event) {
        const file = event.target.files[0];
        const uploadBox = document.querySelector('.upload-box');
        const uploadtxt = document.querySelector('.upload-text');

        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                uploadBox.style.backgroundImage = `url('${e.target.result}')`;
                uploadBox.style.backgroundSize = 'cover';
                uploadBox.style.backgroundPosition = 'center';
                uploadtxt.innerHTML = ''; // Remove the "Add" text
            };
            reader.readAsDataURL(file);
        }

    }
</script>
