@model Database.Core.Domain.Equipment
@* -------------------------------------------------------------------------------------
    Page: Create.cshtml
    Purpose:
        This page allows an admin/manger to add a new equipment record to the system.
        The form collects basic equipment details such as name, description, daily rental price,
        category, condition, and availability. It also supports image upload with real-time preview.

    Features:
        - Text inputs for equipment name, description, and rental price
        - Dropdown selectors for category, condition status, and availability status
        - Image upload field with custom preview box
        - Displays validation errors for individual fields and model-level issues
        - Uses ViewBag to populate dropdown lists from the controller
        - Styled layout using Bootstrap for responsive design
        - Submits to POST /Equipment/Create

    JS Integration:
        - Image preview is triggered using a simple JS function (previewImage)
        - File input is hidden and triggered via the styled upload box
        - Shared JS should define previewImage(event) to render a thumbnail
---------------------------------------------------------------------------------------- *@

@{
    ViewData["Title"] = "Add Equipment";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}

<!-- Page title -->
<div class="text-center my-4">
    <h1 class="text-center mb-5 page-title">Add Equipment</h1>
</div>

<div class="container my-4">
    <!-- Equipment creation form -->
    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div class="row">
            <!-- LEFT SECTION: Form fields -->
            <div class="col-md-8">
                <!-- Summary for model-level validation errors -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Equipment Name input -->
                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label">Name</label>
                    <input asp-for="Name" class="form-control" maxlength="50" minlength="3"
                           oninvalid="this.setCustomValidity('Name should be 3–50 characters')"
                           required
                           oninput="setCustomValidity('')" />
                     <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Description input -->
                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" maxlength="255" minlength="3"
                              oninvalid="this.setCustomValidity('Description should be at least 3 characters')"
                              required
                              oninput="setCustomValidity('')"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Rental price input with decimal pattern -->
                <div class="form-group mb-3">
                    <label asp-for="RentalPricePerDay" class="form-label">Rental Price (BHD / Day)</label>
                    <input asp-for="RentalPricePerDay" class="form-control"
                           inputmode="decimal"
                           pattern="\d+(\.\d{1,2})?"
                           title="Enter a valid price (e.g., 12 or 12.50)" required />
                    <span asp-validation-for="RentalPricePerDay" class="text-danger"></span>
                </div>

                <!-- Category dropdown list -->
                <div class="form-group mb-3">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                </div>

                <!-- Condition and Availability dropdowns -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ConditionStatusId" class="form-label">Equipment Condition</label>
                        <select asp-for="ConditionStatusId" class="form-select" asp-items="ViewBag.ConditionStatusId"></select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="AvailabilityStatusId" class="form-label">Equipment Availability</label>
                        <select asp-for="AvailabilityStatusId" class="form-select" asp-items="ViewBag.AvailabilityStatusId"></select>
                    </div>
                </div>
            </div>

            <!-- RIGHT SECTION: Image upload box -->
            <div class="col-md-4 d-flex align-items-start justify-content-center">
                <!-- Image preview and file input -->
                <div class="upload-box" onclick="document.getElementById('fileInput').click();">
                    <span id="upload-text">Add</span>
                    <input type="file" id="fileInput" name="ImageFile"
                           style="display: none;" accept="image/*"
                           onchange="previewImage(event)" />
                </div>
            </div>
        </div>

        <!-- Form submission buttons -->
        <div class="d-flex justify-content-center gap-3 mt-4">
            <input type="submit" value="Add" class="btn custom-btn" />
            <a asp-action="Index" class="btn custom-btn-outline">Cancel</a>
        </div>
    </form>
</div>
