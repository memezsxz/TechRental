@using Database.Core.Repositories
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using WebApp.ViewModel
@model ListUsersViewModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    if (TempData["editSuccess"] != null)
    {
      
        <div class="alert alert-dismissible alert-success" style="margin-top:2%">
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            <strong>Well done!</strong> @TempData["editSuccess"] 
        </div>
    
    }
}

@*filter design and fuctionality, which can search by the first or last name and filter by the user role*@
<form method="get" asp-controller="Users" asp-action="Index">
    <div class="filter-wrapper d-flex justify-content-center mb-5 mt-4">
        <div class="filter-bar d-flex gap-3 w-100" style="max-width: 90%;">

            <select class="form-select form-select-sm" asp-for="RoleFilter"
                    asp-items="@Model.RolesList.Select(a => new SelectListItem{Text = a.RoleName, Value = a.Id.ToString()})">
                <option value="">All</option>
            </select>

            <input type="text" class="form-control form-control-sm" placeholder="Search by User Name" asp-for="SearchString" />

            <button class="btn btn-success btn-sm px-4" type="submit">Search</button>

            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-danger btn-sm px-4 d-flex align-items-center">
                Clear
            </a>

            <select id="sortBy" name="sortBy" class="form-control">
	            <option value="">Default</option>
	            @foreach (var option in Model.SortOptions)
	            {
		            <option value="@option" selected="@(Model.CurrentSort == option)">
                        @option.GetDisplayName()
		            </option>
	            }
            </select>

            </div>
    </div>
</form>




<h1 class="mb-4" style="color: #2d7d4f;">Users List</h1>

<table class="table table-bordered text-center align-middle">
    <thead style="border-bottom: 2px solid #2d7d4f;">
        <tr style="color: #2d7d4f; font-weight: 600;">
            <th>User ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Role</th>
            <th>Email</th>
            <th>Edit User</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.UsersList)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.Role?.RoleName</td>
                <td>@item.Email</td>
                <td>
                   

                    <div role="group" class="btn-group">
                        <a asp-controller="Users" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary mx-2 d-flex align-items-center gap-1" style="color: #2e7d32; font-weight:bold">
                            <i class="bi bi-pencil-square"></i><span>Edit</span>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="User pagination" class="mt-4">
    <ul class="pagination justify-content-center">

        @if (Model.CurrentPage > 1)
        {
            <li class="page-item">
                <a class="page-link text-success"
                   asp-action="Index"
                   asp-route-page="@(Model.CurrentPage - 1)"
                   asp-route-SearchString="@Model.SearchString"
                   asp-route-RoleFilter="@Model.RoleFilter"
                   asp-route-sortBy="@Model.CurrentSort">

                    <i class="bi bi-chevron-left"></i> Previous
                </a>
            </li>
        }

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                <a class="page-link @(Model.CurrentPage == i ? "bg-success text-white border-success" : "text-success")"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-SearchString="@Model.SearchString"
                   asp-route-RoleFilter="@Model.RoleFilter"
                   asp-route-sortBy="@Model.CurrentSort"
                   style="border-radius: 8px; margin: 0 4px;">
                    @i
                </a>
            </li>
        }

        @if (Model.CurrentPage < Model.TotalPages)
        {
            <li class="page-item">
                <a class="page-link text-success"
                   asp-action="Index"
                   asp-route-page="@(Model.CurrentPage + 1)"
                   asp-route-SearchString="@Model.SearchString"
                   asp-route-RoleFilter="@Model.RoleFilter"
                   asp-route-sortBy="@Model.CurrentSort">
                    Next <i class="bi bi-chevron-right"></i>
                </a>
            </li>
        }

    </ul>
</nav>

