@using Database.Core.Repositories
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using WebApp.ViewModel
@model ListUsersViewModel

@{
    ViewData["Title"] = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">

    @if (TempData["editSuccess"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <strong>Success!</strong> @TempData["editSuccess"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <h2 class="text-center mb-5 page-title">Users List</h2>

    <!-- Filter and Search Form -->
    <form method="get" asp-controller="Users" asp-action="Index" class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4" style="max-width: 1100px; margin: 0 auto;">
        <div style="flex: 1; min-width: 180px;">
            <select class="form-select form-select-sm" asp-for="RoleFilter"
                    asp-items="@Model.RolesList.Select(a => new SelectListItem{Text = a.RoleName, Value = a.Id.ToString()})">
                <option value="">All Roles</option>
            </select>
        </div>

        <div style="flex: 2; min-width: 240px;">
            <input type="text" class="form-control form-control-sm" placeholder="Search by First Name, Last Name" asp-for="SearchString" />
        </div>

        <div style="flex: 1; min-width: 180px;">
            <select id="sortBy" name="sortBy" class="form-select form-select-sm">
                <option value="">Default</option>
                @foreach (var option in Model.SortOptions)
                {
                    <option value="@option" selected="@(Model.CurrentSort == option)">
                        @option.GetDisplayName()
                    </option>
                }
            </select>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-success btn-sm px-4" type="submit">Search</button>
            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-danger btn-sm px-4">Clear</a>
        </div>
    </form>

    <!-- Table -->
    <table class="table table-bordered text-center align-middle">
        <thead class="table-light">
            <tr class="text-success fw-semibold">
                <th>User ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Role</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.UsersList)
            {
                <tr class="user-row"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    title="Click to edit user"
                    data-href="@Url.Action("Edit", "Users", new { id = item.Id })"
                    style="cursor: pointer;">
                    <td>@item.Id</td>
                    <td>@item.FirstName</td>
                    <td>@item.LastName</td>
                    <td>@item.Role?.RoleName</td>
                    <td>@item.Email</td>
                </tr>
            }

            @if (!Model.UsersList.Any())
            {
                <tr>
                    <td colspan="6" class="text-muted py-5 text-center">
                        No users found.
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Pagination -->
    <nav aria-label="User pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Model.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link text-success"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-SearchString="@Model.SearchString"
                       asp-route-RoleFilter="@Model.RoleFilter"
                       asp-route-sortBy="@Model.CurrentSort">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                var isActive = Model.CurrentPage == i ? "active" : "";
                var linkClass = isActive == "active" ? "bg-success text-white border-success" : "text-success";

                <li class="page-item @isActive">
                    <a class="page-link @linkClass"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-SearchString="@Model.SearchString"
                       asp-route-RoleFilter="@Model.RoleFilter"
                       asp-route-sortBy="@Model.CurrentSort"
                       style="border-radius: 8px; margin: 0 4px;">
                        @i
                    </a>
                </li>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link text-success"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-SearchString="@Model.SearchString"
                       asp-route-RoleFilter="@Model.RoleFilter"
                       asp-route-sortBy="@Model.CurrentSort">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>

</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Tooltip activation
            const tooltipList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipList.map(function (el) {
                return new bootstrap.Tooltip(el);
            });

            // Row click behavior
            const rows = document.querySelectorAll(".user-row");
            rows.forEach(row => {
                row.addEventListener("click", () => {
                    const url = row.getAttribute("data-href");
                    if (url) window.location.href = url;
                });
            });
        });
    </script>
}