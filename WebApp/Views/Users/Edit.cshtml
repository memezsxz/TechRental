@using WebApp.ViewModel
@model EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    if (TempData["faild"] != null)
    {
        <div class="alert alert-danger" role="alert" style="margin-top:10px">
            @TempData["faild"].ToString();

        </div>

    }
}
<a asp-action="Index" class="text-success mb-3 d-inline-block">&lt; Back</a>


<div class="row pt-4">
    <div class="col-6">
        <h2 class="mb-4" style="color: #2d7d4f;">Edit User</h2>
    </div>

    <div class="col-6 text-end">
        <a asp-controller="Users" asp-action="Delete" asp-route-id="@Model.User.Id" class="btn btn-danger">
            <i class="bi bi-trash3-fill"></i> Delete
            
        </a>
    </div>
</div>




<form method="post" asp-action="Edit">

    <input type="hidden" asp-for="User.Id" />

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="User.FirstName" class="form-label">First Name</label>
            <input asp-for="User.FirstName" class="form-control" />
            <span asp-validation-for="User.FirstName" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="User.LastName" class="form-label">Last Name</label>
            <input asp-for="User.LastName" class="form-control" />
            <span asp-validation-for="User.LastName" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="User.Email" class="form-label">Email</label>
        <input asp-for="User.Email" class="form-control" />
        <span asp-validation-for="User.Email" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="User.RoleId" class="form-label d-block">User Role</label>
        <select asp-for="User.RoleId"
                asp-items="@(new SelectList(Model.RolesList, "Id", "RoleName", Model.User.RoleId))"
                class="form-select" style="max-width:300px;">
            <option value="" disabled>Select Role</option>
        </select>
        <span asp-validation-for="User.RoleId" class="text-danger"></span>
    </div>

    <div class="d-flex gap-3 mt-4">
        <button type="submit" class="btn btn-success px-5">Save Changes</button>
        <a asp-action="ResetPassword" asp-route-id="@Model.User.Id" class="btn btn-outline-success px-5">Reset Password</a>
    </div>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
