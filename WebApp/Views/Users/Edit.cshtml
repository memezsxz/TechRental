@model Database.Core.Domain.User

@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    if (TempData["faild"] != null)
    {
        <div class="alert alert-danger" role="alert">
            @TempData["faild"]
        </div>

    }
}


<br />
<a asp-action="Index" class="text-success mb-3 d-inline-block">&lt; Back</a>
<div>
    <h2 class="mb-4" style="color: #2d7d4f;">Edit User #@Model.Id.ToString()</h2>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-4 text-end">
        <button type="submit" class="btn btn-danger px-4"><i class="bi bi-trash-fill"></i> Delete User</button>
    </form>

</div>

<form  asp-controller="Users" asp-action="Edit" method="post">

    <div class="row mb-3">
        <div class="col-md-6">
            <label asp-for="Id" class="form-label">User ID</label>
            <input asp-for="Id" class="form-control" readonly />
        </div>
    </div>
    <div class="row mb-3">
   
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label">First Name</label>
            <input asp-for="FirstName" class="form-control" />
            <span class="text-danger" asp-validation-for="FirstName"></span>

        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label">Last Name</label>
            <input asp-for="LastName" class="form-control" />
            <span class="text-danger" asp-validation-for="LastName"></span>

        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span class="text-danger" asp-validation-for="Email"></span>

    </div>

    <div class="mb-4">
        <label class="form-label d-block">User Role</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="RoleId" value="Customer" @(Model.Role.RoleName == "Customer" ? "checked" : "") />
            <label class="form-check-label">Customer</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="RoleId" value="Manager" @(Model.Role.RoleName == "Manager" ? "checked" : "") />
            <label class="form-check-label">Manager</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="RoleId" value="Admin" @(Model.Role.RoleName == "Admin" ? "checked" : "") />
            <label class="form-check-label">Admin</label>
        </div>
    </div>

    <div class="d-flex gap-3">
        <button type="submit" class="btn btn-success px-4">Save Changes</button>
        <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-outline-success px-4">Reset Password</a>
    </div>
</form>


@section Scripts {

    <partial name="_ValidationScriptsPartial">

    }


