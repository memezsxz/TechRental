@model Database.Core.Domain.User
@{
    ViewData["Title"] = "Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row" style="min-height: 90vh;">

        <!-- Left Panel (Profile Info) -->
        <div class="col-md-3 d-flex flex-column align-items-center justify-content-center border-end">
            <h2 style="color: #2d7d4f;">Your Profile</h2>

            <!-- User Image -->
            <div class="my-4">

                <i class="bi bi-person-circle" style="font-size: 5rem; color: #2d7d4f;"></i>
            </div>

            <!-- Role -->
            <button class="btn btn-outline-success mb-5" disabled>
                @Model.Role.RoleName
            </button>

            <!-- Logout -->
                <button type="submit" class="btn btn-danger mt-auto" style="width: 150px;">Log out</button>
            
        </div>

        <!-- Right Panel (Form) -->
        <div class="col-md-9 p-5">
            <form method="post" asp-action="Profile">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">First Name</label>
                        <input asp-for="FirstName" class="form-control"  />
                        <span asp-validation-for="FirstName" class="text-danger"></span>

                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">Last Name</label>
                        <input asp-for="LastName" class="form-control"  />
                        <span asp-validation-for="LastName" class="text-danger"></span>

                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control"/>
                    <span asp-validation-for="Email" class="text-danger"></span>

                </div>

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-success px-5">Save Changes</button>
                    <a class="btn btn-outline-success px-5">Change Password</a>
                </div>
            </form>
        </div>

    </div>
</div>


@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}