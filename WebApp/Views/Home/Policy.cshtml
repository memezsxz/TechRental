@{
    ViewData["Title"] = "Policy Page";
}

<div class="container mt-5">
    <h2 class="fw-bold text-center mb-4">Policy Page</h2>

    <p>Welcome to TechRental! To ensure a smooth and transparent experience for both our customers and staff, please read our policies below.</p>

    <ol>
        <li>
            <strong>Rental Eligibility</strong>
            <ul>
                <li>Customers must create an account and be logged in to request rentals.</li>
            </ul>
        </li>

        <li>
            <strong>Rental Requests</strong>
            <ul>
                <li>All equipment rentals are subject to availability.</li>
                <li>Customers can submit requests specifying the rental and return dates.</li>
                <li>Requests will be reviewed and approved or declined by our staff within 24 hours.</li>
            </ul>
        </li>

        <li>
            <strong>Equipment Use & Care</strong>
            <ul>
                <li>Rented equipment must be used responsibly and returned in the same condition.</li>
                <li>Customers are liable for any damage, loss, or misuse of the equipment during the rental period.</li>
            </ul>
        </li>

        <li>
            <strong>Returns</strong>
            <ul>
                <li>Items must be returned by the agreed return date.</li>
                <li>Items should be returned before the end of business working hours.</li>
                <li>Late returns may incur additional charges.</li>
                <li>Returned items will be inspected for condition before closing the rental.</li>
            </ul>
        </li>

        <li>
            <strong>Payments & Charges</strong>
            <ul>
                <li>Rental charges must be paid before pickup or delivery.</li>
                <li>Additional fees (e.g., deposits, damage fees, late fees) may apply as per the rental agreement.</li>
            </ul>
        </li>

        <li>
            <strong>Cancellations & Refunds</strong>
            <ul>
                <li>Rental requests can be canceled up to 24 hours before the rental start date for a full refund.</li>
                <li>Cancellations within 24 hours of the rental date may not be refunded.</li>
            </ul>
        </li>

        <li>
            <strong>Feedback & Support</strong>
            <ul>
                <li>Customers are encouraged to leave feedback after returning equipment.</li>
                <li>For issues or questions, please contact our support team through your profile dashboard.</li>
            </ul>
        </li>

        <li>
            <strong>Data & Privacy</strong>
            <ul>
                <li>Customer information is stored securely and used only for rental purposes.</li>
                <li>No passwords are stored in plain text. We follow industry best practices to protect your data.</li>
            </ul>
        </li>

        <li>
            <strong>System Notifications</strong>
            <ul>
                <li>Users will receive automated email or in-app notifications for approvals, reminders, and other rental updates.</li>
            </ul>
        </li>

        <li>
            <strong>Terms Acceptance</strong>
            <p>By using TechRental, you agree to follow these policies. We reserve the right to update these terms at any time.</p>
        </li>
    </ol>
</div>
