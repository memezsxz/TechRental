@{
    ViewData["Title"] = "About TechRental";
}

<div class="container my-5">
    <h2 class="text-center mb-4">About <span class="text-success fw-bolder">TechRental</span></h2>

    <p>
        At <span class="text-success fw-bold">TechRental</span>, we make accessing professional equipment easier, faster, and more affordable.
        Whether you’re a student, a freelancer, or a business, our platform allows you to rent high-quality tech gear without the hassle of ownership.
    </p>

    <p>
        Our mission is to support productivity, creativity, and innovation by connecting people with the tools they need—when they need them.
        From cameras and laptops to power tools and event equipment, we offer a wide selection of items that are regularly maintained and ready for use.
    </p>

    <p>
        <span class="text-success fw-bold">TechRental</span> was built with both customers and staff in mind.
        Customers can easily browse available equipment, submit rental requests, track their orders, and return items all through our user-friendly web platform.
        On the other hand, rental companies can manage inventory, process requests, track usage, and monitor returns efficiently.
    </p>

    <p>
        We value trust, transparency, and convenience. That’s why we offer secure payments, clear rental terms, and responsive customer support.
        Your experience matters to us, and we’re constantly working to improve our system and services.
    </p>

    <p>
        Thank you for choosing <span class="text-success fw-bold">TechRental</span>.
        Whether you're capturing moments, building something new, or running an event, we’re here to help you make it happen.
    </p>
</div>

<!-- Contact Section -->
<div id="contact" class="bg-success text-white py-5">
    <div class="container">
        <h2 class="text-center mb-4 text-white">Contact Us</h2>

        <form asp-action="Contact" asp-controller="Home" method="post" class="row g-3 justify-content-center">

            <div class="col-md-4 form-floating">
                <input name="FirstName" type="text" class="form-control" id="firstName" placeholder="First Name" required>
                <label for="firstName" class="text-dark">First Name</label>
            </div>

            <div class="col-md-4 form-floating">
                <input name="LastName" type="text" class="form-control" id="lastName" placeholder="Last Name" required>
                <label for="lastName" class="text-dark">Last Name</label>
            </div>

            <div class="col-md-8 form-floating">
                <input name="Email" type="email" class="form-control" id="email" placeholder="Email" required>
                <label for="email" class="text-dark">Email</label>
            </div>

            <div class="col-md-8 form-floating">
                <textarea name="Message" class="form-control" placeholder="Message" id="message" style="height: 150px;" required></textarea>
                <label for="message" class="text-dark">Message</label>
            </div>

            <div class="col-md-8 text-center">
                <button type="submit" class="btn btn-light px-5 mt-2">Submit</button>
            </div>
        </form>
    </div>
</div>


