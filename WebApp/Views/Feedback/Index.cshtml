@model IEnumerable<Database.Core.Domain.Feedback>

@{
    ViewData["Title"] = "Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="mb-3">
        <a asp-action="Index" asp-controller="Equipment" class="text-success text-decoration-none">&lt; Back</a>
    </div>

    <!-- Title -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-success text-center flex-grow-1 mb-0">FEEDBACK</h2>

        <!-- Toggle Buttons -->
        <div class="btn-group" role="group">
            <a href="@Url.Action("Index", "Feedback", new { id = ViewBag.EquipmentId, status = "Hidden" })"
               class="btn btn-outline-success px-4 @(ViewBag.Status == "Hidden" ? "active" : "")"
               style="border-radius: 8px 0 0 8px;">
                HIDDEN
            </a>
            <a href="@Url.Action("Index", "Feedback", new { id = ViewBag.EquipmentId, status = "Unhidden" })"
               class="btn btn-outline-success px-4 @(ViewBag.Status == "Unhidden" ? "active" : "")"
               style="border-radius: 0 8px 8px 0;">
                UNHIDDEN
            </a>
        </div>
    </div>

    <!-- Feedback Cards -->
    @foreach (var comment in Model)
    {
        <div class="feedback-card d-flex justify-content-between align-items-center py-3 border-bottom">
            <div class="d-flex align-items-start">
                <img src="@Url.Action("GetImage", "Image", new { id = comment.User.ImageId })"
                     class="user-avatar me-3"
                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%; margin-top: -6px;"
                     alt="User Avatar" />
                <div>
                    <strong>@comment.User.FirstName @comment.User.LastName</strong>
                    <p class="text-muted mb-1">@comment.Note</p>
                    <div class="rating-stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="fa fa-star @(i <= comment.Rate ? "text-success" : "text-secondary")"></i>
                        }
                    </div>
                </div>
            </div>

            <form asp-action="Edit" asp-route-id="@comment.Id" method="post" class="align-self-center">
                <button type="submit"
                        class="btn text-white"
                        style="background-color: #dc3545; border-radius: 8px; border: 1px solid #dc3545; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1); padding: 6px 18px;">
                    @(comment.IsHidden == true ? "Unhide" : "Hide")
                </button>
            </form>
        </div>
    }
</div>
