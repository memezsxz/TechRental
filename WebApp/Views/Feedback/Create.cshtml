@model Database.Core.Domain.Feedback

@{
    ViewData["Title"] = "Add Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="mb-3">
        <a asp-action="Details" asp-controller="RentalRecords" asp-route-id="@Model.RentalRecordId" class="text-success text-decoration-none">&lt; Back</a>
    </div>

    <h2 class="fw-bold text-success mb-4">Add Feedback</h2>

    <form asp-action="Create" method="post" onsubmit="return validateFeedbackForm();">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-4">
            <label asp-for="Note" class="form-label">Note</label>
            <textarea asp-for="Note" class="form-control" rows="6" placeholder="Write your comment here..."></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label class="form-label">Rate</label>
            <div class="rating-stars d-flex align-items-center">
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="fa fa-star star @(i <= Model.Rate ? "text-success" : "text-muted")" onclick="setRating(@i)"></i>
                }
                <input type="hidden" id="Rate" name="Rate" asp-for="Rate" />
            </div>
            <span asp-validation-for="Rate" class="text-danger"></span>
        </div>

        <!-- Hidden Fields -->
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="EquipmentId" />
        <input type="hidden" asp-for="RentalRecordId" />

        <div class="d-flex gap-3 mt-4">
            <button type="submit" class="btn btn-success px-4">Save Changes</button>
            <a asp-action="Details" asp-controller="RentalRecords" asp-route-id="@Model.RentalRecordId" class="btn btn-outline-success px-4">Cancel</a>
        </div>
    </form>
</div>
