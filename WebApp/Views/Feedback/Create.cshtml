@model Database.Core.Domain.Feedback

@{
    ViewData["Title"] = "Add Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="mb-3">
        <a asp-action="Index" asp-controller="Equipment" class="text-success text-decoration-none">&lt; Back</a>
    </div>

    <h2 class="fw-bold text-success mb-4">Add Feedback</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-4">
            <label asp-for="Note" class="form-label">Note</label>
            <textarea asp-for="Note" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>

        <div class="form-group mb-4">
            <label asp-for="Rate" class="form-label">Rate</label>
            <div class="rating-stars">
                @* @for (int i = 1; i <= 5; i++) *@
                @* { *@
                @*     <i class="fa fa-star star @(i <= Model.Rate ? "text-success" : "text-muted")" onclick="document.getElementById('Rate').value = '@i'; updateStars(@i)"></i> *@
                @* } *@
                <input type="hidden" id="Rate" name="Rate" asp-for="Rate" />
                <span asp-validation-for="Rate" class="text-danger"></span>
            </div>
        </div>

        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="EquipmentId" />

        <div class="d-flex gap-3">
            <input type="submit" value="Save Changes" class="btn custom-btn px-4" />
            <a asp-action="Index" asp-controller="Equipment" class="btn custom-btn-outline px-4">Cancel</a>
        </div>
    </form>
</div>

<style>
    .rating-stars .fa-star {
        font-size: 1.5rem;
        cursor: pointer;
        margin-right: 5px;
    }
</style>

@section Scripts {
    <script>
        function updateStars(rate) {
            const stars = document.querySelectorAll('.rating-stars .fa-star');
            stars.forEach((star, index) => {
                if (index < rate) {
                    star.classList.remove('text-muted');
                    star.classList.add('text-success');
                } else {
                    star.classList.remove('text-success');
                    star.classList.add('text-muted');
                }
            });
        }
    </script>
}
