@model Database.Core.Domain.RentalRecord

@{
    ViewData["Title"] = ViewBag.Mode == "return" ? "Complete Rental Return" : "Create Rental Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var request = ViewBag.RentalRequest as Database.Core.Domain.RentalRequest;
    var mode = ViewBag.Mode as string ?? "transaction";
    var totalDays = (request.ReturnDate.Date - request.StartDate.Date).Days + 1;
    var totalCost = totalDays * request.RentalPerDay;
    var today = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
    var startDateTime = request.StartDate.ToString("yyyy-MM-ddTHH:mm");
    var returnDateTime = request.ReturnDate.ToString("yyyy-MM-ddTHH:mm");
    var payment = Model.Payments?.FirstOrDefault();
    var documentId = ViewBag.DocumentId as int?;
}

<div class="mb-4 mt-3">
    <a asp-action="Index" class="text-success">&lt; Back</a>
</div>

<h2 class="text-center mb-5 page-title">@ViewData["Title"]</h2>

<!-- CUSTOMER INFO -->
<div class="container mb-5 pb-4 border-bottom">
    <h4 class="mb-4 text-success fw-semibold">Customer Info</h4>
    <div class="row mb-4">
        <div class="col-md-6">
            <label>First Name</label>
            <input class="form-control" value="@request?.Customer?.FirstName" readonly />
        </div>
        <div class="col-md-6">
            <label>Last Name</label>
            <input class="form-control" value="@request?.Customer?.LastName" readonly />
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <label>Phone Number</label>
            <input class="form-control" value="@request?.Customer?.PhoneNumber" readonly />
        </div>
        <div class="col-md-6">
            <label>Email</label>
            <input class="form-control" value="@request?.Customer?.Email" readonly />
        </div>
    </div>
</div>

<!-- TRANSACTION INFO -->
<div class="container mb-5 pb-4 border-bottom">
    <h4 class="mb-4 text-success fw-semibold">Transaction Info</h4>
    <div class="row mb-4">

        @if (mode == "return"){
            <div class="col-md-6">
                <label>Request ID</label>
                <input class="form-control" value="@request?.Id" readonly />
            </div>
            <div class="col-md-6">
                <label>Rental Record ID</label>
                <input class="form-control" value="@Model?.Id" readonly />
            </div>
        } else {
            <div class="col-md-12">
                <label>Request ID</label>
                <input class="form-control" value="@request?.Id" readonly />
            </div>
        }
    </div>
    <div class="row mb-4">
        <div class="col-md-6">
            <label>Equipment Title</label>
            <input class="form-control" value="@request?.Equipment.Name" readonly />
        </div>
        @if (mode == "return") {
            <div class="col-md-6">
                <label>Actual Pickup Date</label>
                <input class="form-control" value="@Model?.PickupDate" readonly />
            </div>

        } else {
            <div class="col-md-6">
                <label>Actual Pickup Date</label>
                <input id="actualPickupDate"
                       class="form-control flatpickr-input"
                       placeholder="Select pickup date and time" />
            </div>
        }
    </div>
    <div class="row mb-4">
        <div class="col-md-4">
            <label>Start Date</label>
            <input class="form-control" value="@request?.StartDate.ToString("g")" readonly />
        </div>
        <div class="col-md-4">
            <label>Return Date</label>
            <input class="form-control" value="@request?.ReturnDate.ToString("g")" readonly />
        </div>
        <div class="col-md-4">
            <label>Number of Days</label>
            <input class="form-control" value="@totalDays" readonly />
        </div>
    </div>
    <div class="row mb-4">
        <div class="col-md-4">
            <label>Deposit</label>
            <input asp-for="Deposit" class="form-control" value="@Model?.Deposit?.ToString("0.00")" readonly />
        </div>
        <div class="col-md-4">
            <label>Rental Fee (BD)</label>
            <input asp-for="RentalFee" class="form-control" value="@Model?.RentalFee?.ToString("0.00")" readonly />
        </div>
        <div class="col-md-4">
            <label>Total Cost (BD)</label>
            <input asp-for="TotalCost" class="form-control" value="@Model?.TotalCost.ToString("0.00")" readonly />
        </div>
    </div>
    <div class="mb-4">
        @if (mode == "return" && documentId != null)
        {
            <a href="@Url.Action("GetPdf", "Document", new { id = documentId})"
               class="btn btn-success px-4" target="_blank">View Agreement</a>
        }
    </div>
</div>

<!-- PAYMENT INFO -->
@if (mode == "return")
{
    <div class="container mb-5 pb-4 border-bottom">
        <h4 class="mb-4 text-success fw-semibold">Payment Info</h4>
        <div class="row mb-4">
            <div class="col-md-4">
                <label>Amount</label>
                <input class="form-control" value="@payment?.Amount.ToString("0.00")" readonly />
            </div>
            <div class="col-md-4">
                <label>Method</label>
                <input class="form-control" value="@payment?.PaymentMethod?.MethodName" readonly />
            </div>
            <div class="col-md-4">
                <label>Status</label>
                <input class="form-control" value="@payment?.PaymentStatus?.StatusName" readonly />
            </div>
        </div>
    </div>
}

<!-- FORM -->
<div class="container mb-5">
    <h4 class="mb-4 text-success fw-semibold">Rental @((mode == "return") ? "Return" : "Transaction")</h4>

    <form asp-action="@(mode == "return" ? "CompleteReturn" : "CreateTransaction")" enctype="multipart/form-data" onsubmit="return validateReturnForm()">
        <input type="hidden" asp-for="RentalRequestId" value="@request?.Id" />
        <input type="hidden" asp-for="Id" />
        <!-- Hidden input that will be filled before submission -->
        <input asp-for="PickupDate" type="hidden" name="PickupDate" id="hiddenPickupDate" />

        @if (mode == "transaction")
        {   //class="btn  w-100 mb-3"
            <div class="form-group mb-4">
                <label>Rental Agreement</label>
                <div class="d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("DownloadAgreement", "Document", new { rentalRequestId = request.Id })" class="btn btn-outline-success custom-action-btn px-4" target="_blank">Download Agreement PDF</a>
                    <input type="file" id="agreementUpload" name="Agreement" class="form-control w-50" accept="application/pdf" />
                </div>
                <small class="text-danger d-none" id="fileError">Please upload the signed agreement PDF.</small>
            </div>

            <hr />
            <h5 class="text-success mb-3">Payment Details</h5>
            <div class="row mb-4">
                <div class="col-md-4">
                    <label>Amount (BD)</label>
                    <input type="text" class="form-control" name="Amount" value="@Model?.TotalCost.ToString("0.00")" readonly />
                </div>
                <div class="col-md-4">
                    <label for="PaymentMethodId">Payment Method</label>
                    <select name="PaymentMethodId" class="form-select">
                        @foreach (var method in ViewBag.PaymentMethodId as SelectList)
                        {
                            @:<option value="@method.Value" @(method.Value == "3" ? "selected" : null)>@method.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="PaymentStatusId">Payment Status</label>
                    <select name="PaymentStatusId" class="form-select" disabled>
                        @foreach (var status in ViewBag.PaymentStatusId as SelectList)
                        {
                            @:<option value="@status.Value"  @(status.Value == "2" ? "selected" : null)>@status.Text</option>
                        }
                    </select>
                </div>
            </div>
        }
        else
        {
            <!-- Return Mode Inputs (Unchanged) -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="ActualReturnDate">Actual Return Date</label>
                    <input type="text"
                           id="actualReturnDate"
                           name="ActualReturnDate"
                           class="form-control flatpickr-input"
                           placeholder="Select return date and time" />
                    <span asp-validation-for="ActualReturnDate" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ReturnConditionId">Return Condition</label>
                    <select asp-for="ReturnConditionId" asp-items="ViewBag.ReturnConditionId" class="form-select"></select>
                    <span asp-validation-for="ReturnConditionId" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="LateReturnFees">Late Return Fees</label>
                    <input asp-for="LateReturnFees" class="form-control" id="lateFee" value="0.00" oninput="this.value = this.value.replace(/[^0-9.]/g, '')" />
                    <span asp-validation-for="LateReturnFees" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ExtraCharges">Extra Charges</label>
                    <input asp-for="ExtraCharges" class="form-control" id="extraCharge" value="0.00" oninput="this.value = this.value.replace(/[^0-9.]/g, '')" />
                    <span asp-validation-for="ExtraCharges" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-4">
                <label asp-for="ExtraChargeDescription">Extra Charge Description</label>
                <textarea asp-for="ExtraChargeDescription" class="form-control" rows="2"></textarea>
                <span asp-validation-for="ExtraChargeDescription" class="text-danger"></span>
            </div>
        }

        <div class="form-group">
            <input type="submit" value="@(mode == "return" ? "Complete Return" : "Create")" class="btn btn-success px-4" />
        </div>
    </form>
</div>

<!-- Add min to actual pickup date field -->
@section Scripts {
    <script>
        function validateReturnForm() {
            const mode = '@mode';

            if (mode === 'transaction') {
                const fileInput = document.getElementById('agreementUpload');
                const fileError = document.getElementById('fileError');

                const pickup = document.getElementById('actualPickupDate')?.value;
                if (!pickup) {
                    showFlash("Please select the actual pickup date.", "warning");
                    return false;
                }
                if (!fileInput || fileInput.files.length === 0) {
                    showFlash("Please upload the signed agreement PDF.", "warning");
                    fileError.classList.remove('d-none');
                    return false;
                }

                fileError.classList.add('d-none');
                return true;
            }

            // Validate return fields
            const actualReturnDate = document.querySelector('[name="ActualReturnDate"]').value;
            const returnCondition = document.querySelector('[name="ReturnConditionId"]').value;
            const lateFee = document.querySelector('#lateFee')?.value;
            const extraCharge = document.querySelector('#extraCharge')?.value;

            if (!actualReturnDate || !returnCondition || lateFee === "" || extraCharge === "") {
                showFlash("All fields except Extra Charge Description must be filled.", "warning");
                return false;
            }

            return true;
        }

        window.addEventListener("DOMContentLoaded", () => {
            const returnDate = new Date('@request.ReturnDate.ToString("yyyy-MM-ddTHH:mm")');
            const actualReturnInput = document.querySelector('[name="ActualReturnDate"]');
            const rentalPerDay = parseFloat('@request.RentalPerDay');
            const lateFeeInput = document.getElementById('lateFee');

            // Set default return date to today
            if (actualReturnInput && !actualReturnInput.value) {
                const now = new Date();
                actualReturnInput.value = now.toISOString().slice(0, 16);
            }

            if (actualReturnInput && lateFeeInput) {
                actualReturnInput.addEventListener("change", () => {
                    const actualReturn = new Date(actualReturnInput.value);
                    let daysLate = Math.floor((actualReturn - returnDate) / (1000 * 60 * 60 * 24));

                    if (daysLate > 0) {
                        let totalLateFee = 0;
                        for (let i = 1; i <= daysLate; i++) {
                            const multiplier = Math.min(1 + 0.05 * i, 1.20);
                            totalLateFee += rentalPerDay * multiplier;
                        }
                        lateFeeInput.value = totalLateFee.toFixed(2);
                    } else {
                        lateFeeInput.value = "0.00";
                    }
                });
            }

            // Restrict Late Fee & Extra Charges to numeric input
            ["lateFee", "extraCharge"].forEach(id => {
                const input = document.getElementById(id);
                if (input) {
                    input.addEventListener("input", () => {
                        input.value = input.value.replace(/[^0-9.]/g, '');
                    });
                }
            });
        });

        window.addEventListener("DOMContentLoaded", () => {
            const pickupInput = document.getElementById("actualPickupDate");

            // Set flatpickr on the input
            flatpickr(pickupInput, {
                enableTime: true,
                dateFormat: "Y-m-d\\TH:i",
                defaultDate: null,
                allowInput: true,
                minDate: "@request.StartDate.ToString("yyyy-MM-ddTHH:mm")",
                maxDate: "@request.ReturnDate.AddDays(-1).ToString("yyyy-MM-ddTHH:mm")",

                // Update hidden input when user picks a date
                onChange: function(selectedDates, dateStr) {
                    document.getElementById("hiddenPickupDate").value = dateStr;
                }
            });
        });


        window.addEventListener("DOMContentLoaded", () => {
            const returnDateStr = "@request.ReturnDate.ToString("yyyy-MM-ddTHH:mm")";
            const returnDate = new Date(returnDateStr);
            const now = new Date();

            // Default to today if today >= returnDate, else returnDate
            const defaultReturnDate = now >= returnDate ? now : returnDate;

            flatpickr("#actualReturnDate", {
                enableTime: true,
                dateFormat: "Y-m-d\\TH:i",
                defaultDate: defaultReturnDate,
                minDate: returnDate
            });
        });
    </script>
}


