@{
    ViewData["Title"] = "Page Not Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center mt-5 pt-5">
    <img src="https://cdn-icons-png.flaticon.com/512/2748/2748558.png" alt="404 Icon" width="120" class="mb-4" />
    <h1 class="display-4 text-danger fw-bold">404</h1>
    <h2 class="mb-3">Page Not Found</h2>
    <p class="lead">Oops! The page you're looking for doesn't exist or has been moved.</p>

    <a href="@Url.Action("Index", "Home")" class="btn btn-success mt-4 px-4">
        Go to Homepage
    </a>
</div>
