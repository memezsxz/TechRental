@using Identity
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tech Rental</title>
    <link rel="stylesheet" href="~/css/Lux.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/equipmentStyle.css" asp-append-version="true" /> 
    <link rel="stylesheet" href="~/css/FlatpickrStyleSheet.css" asp-append-version="true" /> 
    <link rel="stylesheet" href="~/css/EquipmentIndexStyleSheet.css" asp-append-version="true" /> 


    <link rel="stylesheet" href="~/css/authenticationStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Add Font Awesome for star ratings -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet" />

    <!-- Flatpickr CSS & JS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm py-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bolder text-success fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    Tech Rental
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-center" id="mainNavbar">
                    <ul class="navbar-nav">




                        @{

                            // ----------------------------------------------------------------------
                            // --------------------- Unauthenticated Users Tab bar ------------------
                            // ----------------------------------------------------------------------


                            if (!User.Identity.IsAuthenticated || User.IsInRole(RoleConstants.Customer))

                            {
                                <li class="nav-item mx-2">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-area="" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>



                                <li class="nav-item dropdown mx-2">
                                    <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shop" ? "active" : "") text-dark" href="#" id="shopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Shop
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="shopDropdown" id="categoryDropdown">
                                        <li class="dropdown-item text-muted">Loading...</li>
                                    </ul>
                                </li>


                                // ----------------------------------------------------------------------
                                // ---------------------------- Customer Tab bar ------------------------
                                // ----------------------------------------------------------------------

                                if (User.IsInRole(RoleConstants.Customer))
                                {
                                    <li class="nav-item dropdown mx-2">
                                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "RentalRequest" || ViewContext.RouteData.Values["controller"]?.ToString() == "RentalRecords" ? "active" : "") text-dark" href="#" id="shopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            My Rentals
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="Dropdown">
                                            <li><a class="dropdown-item text-black" asp-controller="RentalRequest" asp-action="Index" >Requests</a></li>
                                            <li><a class="dropdown-item text-black" asp-controller="RentalRecords" asp-action="Index" asp-route-status="transaction" >Transactions</a></li>
                                            <li><a class="dropdown-item text-black" asp-controller="RentalRecords" asp-action="Index" asp-route-status="return">Returns</a></li>
                                        </ul>
                                    </li>

                                }


                                <li class="nav-item mx-2">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "") text-dark" asp-controller="Home" asp-action="About">About</a>
                                </li>





                            }




                            // ----------------------------------------------------------------------
                            // -------------------------------Admin Tab bar ------------------------
                            // ----------------------------------------------------------------------

                            if (User.IsInRole(RoleConstants.Admin) || User.IsInRole(RoleConstants.Manager)) 
                            {
                                <li class="nav-item mx-2">
                                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "") text-dark" asp-controller="" asp-action="">Dashboard</a>
                                </li>


                                <li class="nav-item dropdown mx-2">
                                    <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "RentalRequest" || ViewContext.RouteData.Values["controller"]?.ToString() == "RentalRecords" ? "active" : "") text-dark" href="#" id="shopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Rentals
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="Dropdown">
                                        <li><a class="dropdown-item text-black" asp-controller="RentalRequest" asp-action="Index">Requests</a></li>
                                        <li><a class="dropdown-item text-black" asp-controller="RentalRecords" asp-action="Index" asp-route-status="transaction">Transactions</a></li>
                                        <li><a class="dropdown-item text-black" asp-controller="RentalRecords" asp-action="Index" asp-route-status="return">Returns</a></li>
                                    </ul>
                                </li>

                                if (User.IsInRole(RoleConstants.Manager))
                                {
                                    <li class="nav-item mx-2">
                                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Equipment" ? "active" : "") text-dark" asp-controller="Equipment" asp-action="Index">Management Equipments</a>
                                    </li>
                                }
                                else     
                                {
                                    <li class="nav-item dropdown mx-2">
                                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Equipment" || ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "") text-dark" href="#" id="shopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Inventory Management
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="Dropdown">
                                            <li><a class="dropdown-item text-black" asp-controller="Equipment" asp-action="Index">Equipments</a></li>
                                            <li><a class="dropdown-item text-black" asp-controller="Categories" asp-action="Index">Categories</a></li>
                                        </ul>
                                    </li>


                                    <li class="nav-item mx-2">
                                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "") text-dark" asp-controller="Users" asp-action="Index">Users</a>
                                    </li>


                                    <li class="nav-item dropdown mx-2">
                                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLogs" || ViewContext.RouteData.Values["controller"]?.ToString() == "ErrorLogs" ? "active" : "") text-dark" href="#" id="shopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            System Logs
                                        </a>
                                        <ul class="dropdown-menu" aria-labelledby="Dropdown">
                                            <li><a class="dropdown-item text-black" asp-controller="AuditLogs" asp-action="Index">Audit Trails</a></li>
                                            <li><a class="dropdown-item text-black" asp-controller="ErrorLogs" asp-action="Index">Error Logs</a></li>
                                        </ul>
                                    </li>
                                
                                }


                            }

                        }
                        


       



                        @* <li class="nav-item dropdown mx-2"> *@
                        @*     <a class="nav-link dropdown-toggle text-dark" href="#" id="shopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"> *@
                        @*         Admin *@
                        @*     </a> *@
                        @*     <ul class="dropdown-menu" aria-labelledby="shopDropdown"> *@
                        @*         <li><a class="dropdown-item text-black" asp-controller="Users" asp-action="Index">Users</a></li> *@
                        @*         <li><a class="dropdown-item text-black" asp-controller="Categories" asp-action="Index">Categories</a></li> *@
                        @*         <li><a class="dropdown-item text-black" asp-controller="AuditLogs" asp-action="Index">Audit Logs</a></li> *@
                        @*         <li><a class="dropdown-item text-black" asp-controller="ErrorLogs" asp-action="Index">Error Logs</a></li> *@
                        @*     </ul> *@
                        @* </li> *@

                        @* <li class="nav-item dropdown mx-2"> *@
                        @*     <a class="nav-link dropdown-toggle text-dark" href="#" id="shopDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"> *@
                        @*         Manager *@
                        @*     </a> *@
                        @*     <ul class="dropdown-menu" aria-labelledby="shopDropdown"> *@
                        @*         <li><a class="dropdown-item text-black" asp-controller="Categories" asp-action="Index">Categories</a></li> *@
                        @*         <li><a class="dropdown-item text-black" asp-controller="RentalRequest" asp-action="Index">RentalRequest</a></li> *@
                        @*     </ul> *@
                        @* </li> *@



                    </ul>
                </div>

                <div class="d-flex">

                    @{
                        if (User.IsInRole(RoleConstants.Customer))
                        {
                            <button class="btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#notificationsPanel" aria-controls="notificationsPanel">
                                <i id="navbarBellIcon" class="bi bi-bell" style="font-size: 1.5rem;"></i>
                            </button>
                             
                            


                        }
                    }


                    <partial name="_LoginPartial" />

                    @* <a class="btn btn-success me-2 px-4 text-white" href="#">Login</a> *@
                    @* <a class="btn btn-outline-success px-4 text-black" href="#">Sign up</a> *@
                </div>
            </div>
        </nav>


        <!-- Notifications Panel -->
        <div class="offcanvas offcanvas-end wide-panel" tabindex="-1" id="notificationsPanel" aria-labelledby="notificationsPanelLabel">
            <div class="offcanvas-header">
                <h3 class="offcanvas-title fw-bold" style="font-size: 1.75rem;" id="notificationsPanelLabel">Notifications</h3>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>

            <!-- Notifications List -->
            <div class="offcanvas-body" id="notificationList">
                <div class="text-muted">Loading notifications...</div>
            </div>

            <!-- Notification Details (Initially Hidden) -->
            <div class="offcanvas-body" id="notificationDetails" style="display: none;">
                <a href="#" id="backToList" class="text-success mb-3 d-block"><i class="bi bi-arrow-left-circle-fill"></i> Back</a>
                <h5 id="notificationTitle" class="fw-bold"></h5>
                <div class="p-4 bg-light rounded mt-3">
                    <p id="notificationMessage" class="mb-0"></p>
                </div>
            </div>
        </div>


    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>


        <!-- Flash Message Modal (Auto close) -->
        <div class="modal fade" id="flashMessageModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-center p-4">
                    <i id="flashIcon" class="mb-3" style="font-size: 2rem;"></i>
                    <p id="flashText" class="mb-0"></p>
                </div>
            </div>
        </div>

        <!-- Confirmation Modal -->
        <div class="modal fade" id="confirmationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-center p-4">
                    <i class="fas fa-question-circle text-info mb-3" style="font-size: 2rem;"></i>
                    <p id="confirmationText" class="mb-3"></p>
                    <div class="d-flex justify-content-center gap-3">
                        <button id="confirmYes" class="btn btn-success px-4">Yes</button>
                        <button class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TempData bindings -->
        <input type="hidden" id="tempDataMessage" value="@(TempData["MessageText"] ?? "")" />
        <input type="hidden" id="tempDataMessageType" value="@(TempData["MessageType"] ?? "")" />
    </div>

    <!-- shared JS file -->
    <script src="~/js/site-scripts.js" asp-append-version="true"></script>
    <script src="~/js/ToolBarJavaScript.js" asp-append-version="true"></script>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Tech Rental - <a asp-area="" asp-controller="Home" asp-action="Policy">Policy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site_notifications.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
